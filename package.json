{
  "name": "verax",
  "private": true,
  "version": "0.0.1",
  "description": "GraphQL over RDF, compiled with a plan-level security kernel. Monorepo root.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run -s typecheck && vitest run --silent",
    "corpus:check": "vitest run corpus",
    "corpus:snapshot:core": "tsx scripts/emit-core-sdl.ts && tsx scripts/emit-core-plans.ts"
  },
  "devDependencies": {
    "@types/n3": "^1.26.4",
    "@types/node": "^20.19.43",
    "graphql": "^16.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
