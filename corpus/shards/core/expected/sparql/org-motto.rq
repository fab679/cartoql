SELECT DISTINCT ?v0_e ?v0_e_0_v ?v0_e_1_v
WHERE {
  { SELECT ?v0_e
  WHERE {
    GRAPH <urn:verax:shard:core> { ?v0_e a <https://verax.example/corpus/core#Organization> }
    FILTER(isIRI(?v0_e))
  }
  ORDER BY ?v0_e
  LIMIT 11 }
  GRAPH <urn:verax:shard:core> {
  OPTIONAL { ?v0_e <https://verax.example/corpus/core#name> ?v0_e_0_v }
  OPTIONAL { ?v0_e <https://verax.example/corpus/core#motto> ?v0_e_1_v }
  }
}
ORDER BY ?v0_e
