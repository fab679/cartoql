SELECT DISTINCT ?v0_e ?v0_e_0_v ?v0_e_1_v ?v0_e_1 ?v0_e_1_0_v
WHERE {
  { SELECT ?v0_e
  WHERE {
    GRAPH <urn:cartoql:shard:core> { ?v0_e a <https://cartoql.example/corpus/core#Person> }
    FILTER(isIRI(?v0_e))
  }
  ORDER BY ?v0_e
  LIMIT 3 }
  GRAPH <urn:cartoql:shard:core> {
  OPTIONAL { ?v0_e <https://cartoql.example/corpus/core#name> ?v0_e_0_v }
  OPTIONAL { ?v0_e <https://cartoql.example/corpus/core#authored> ?v0_e_1 .
    FILTER(isIRI(?v0_e_1))
  OPTIONAL { ?v0_e_1 <https://cartoql.example/corpus/core#name> ?v0_e_1_0_v }
  }
  }
}
ORDER BY ?v0_e
