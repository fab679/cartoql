SELECT DISTINCT ?v0_e ?v0_e_0_v
WHERE {
  { SELECT ?v0_e
  WHERE {
    GRAPH <urn:verax:shard:core> { ?v0_e a <https://verax.example/corpus/core#Organization> }
  }
  ORDER BY ?v0_e
  LIMIT 3 }
  GRAPH <urn:verax:shard:core> {
  OPTIONAL { ?v0_e <https://verax.example/corpus/core#name> ?v0_e_0_v }
  }
}
ORDER BY ?v0_e

SELECT DISTINCT ?v1_e ?v1_e_0_v
WHERE {
  GRAPH <urn:verax:shard:core> {
  ?v1_e a <https://verax.example/corpus/core#Person> .
  OPTIONAL { ?v1_e <https://verax.example/corpus/core#name> ?v1_e_0_v }
  }
}
